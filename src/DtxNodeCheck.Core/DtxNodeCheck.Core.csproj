<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DtxNodeCheck.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\DtxNodeCheck\Checks\*.cs" Link="Checks\%(Filename)%(Extension)" />
    <Compile Include="..\DtxNodeCheck\Configuration\*.cs" Link="Configuration\%(Filename)%(Extension)" />
    <Compile Include="..\DtxNodeCheck\Diagnostics\*.cs" Link="Diagnostics\%(Filename)%(Extension)" />
    <Compile Include="..\DtxNodeCheck\Inventory\*.cs" Link="Inventory\%(Filename)%(Extension)" />
    <Compile Include="..\DtxNodeCheck\Reporting\*.cs" Link="Reporting\%(Filename)%(Extension)" />
    <Compile Include="..\DtxNodeCheck\NodeKind.cs" Link="NodeKind.cs" />
  </ItemGroup>
</Project>
